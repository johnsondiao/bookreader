{
  "name": "langyue-reader",
  "private": true,
  "version": "1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check-version && npm run test:unit && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check-version": "node scripts/check-version.cjs",
    "test:unit": "vitest run tests/core.test.ts",
    "test": "npm run test:unit",
    "cap:sync": "npm run check-version && npm run build && npx cap sync android",
    "android:add": "npx cap add android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3",
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.1.1"
  }
}
